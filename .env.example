# 山海问知 环境变量示例（复制为 .env 后修改）。不要把真实 Key 提交到代码仓库。
# 注意：注释请单独占一行，不要写在值的后面。
PORT=3000
SITE_URL=https://你的域名
SESSION_SECRET=请替换为随机长字符串
# 32字节随机串（用于可选的Key加密保存）
KEY_ENC_SECRET=请替换为随机长字符串
TEACHER_ACCOUNTS=teacher:请替换密码
DATA_DIR=./data
APP_TZ=Asia/Shanghai
# 首次启动时默认班级的邀请码（不填则随机生成，可在教师后台修改）
DEFAULT_INVITE_CODE=

# TokenONE 中转站的 /v1 地址：https://token.agentone.work/v1
# 填 mock 时使用内置模拟模型（没有真实 Key 时用于开发自测，界面会标注“模拟模型”）
LLM_BASE_URL=mock
# TokenONE 上 DeepSeek 分组的模型（2026-10-12 查询，以中转站“模型广场”实际名称为准）
LLM_CHAT_MODEL=deepseek-v4.1-flash
# 可空：TokenONE 目前没有单独的 DeepSeek 推理模型，留空时画像、方案也用对话模型
LLM_REASON_MODEL=
# auto | on | off
TOOL_CALLING=auto
# auto（默认）| on | off：推理模型是否先输出思考过程；off 更快、更省 token
LLM_THINKING=auto
# 平台 Key（也可在后台配置，后台优先）
LLM_PLATFORM_KEY=
# 每人每日基础调用上限
BASIC_DAILY_LIMIT=60
# 班级月度 token 预算，可空
MONTHLY_TOKEN_BUDGET=
# 评委沙箱的高阶模块使用，设调用上限
DEMO_API_KEY=

# relay | bocha | none
SEARCH_PROVIDER=none
SEARCH_RELAY_MODEL=
BOCHA_API_KEY=
# 博查接口地址（官方也提供 https://api.bocha.cn/v1）
BOCHA_BASE_URL=https://api.bochaai.com/v1
SEARCH_DAILY_LIMIT_PER_USER=30

SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=
# QQ邮箱授权码（不是QQ密码）
SMTP_PASS=
SMTP_FROM_NAME=山海问知

OPENALEX_MAILTO=
# 可选：中转站提供的向量模型；空则导师知识库只用 FTS5 关键词检索
EMBEDDING_MODEL=
# 导师团每场会议最大轮数
GROUP_MAX_ROUNDS=10
CROSSREF_MAILTO=
